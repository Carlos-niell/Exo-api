{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d",
		"name": "ExoApi - SENAI (Projetos + Segurança JWT)",
		"description": "Coleção completa de testes para a API ExoApi no Postman, contendo Autenticação e Autorização JWT (200, 401, 403), CRUD de Projetos e Usuários, e testes de exceções (400, 404, 409).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🔐 1. Autenticação e Autorização (JWT)",
			"item": [
				{
					"name": "1.1. Login Admin (Gera e Salva Token JWT automaticamente)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"jwtToken\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@exoapi.com\",\n  \"senha\": \"admin123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/usuarios/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"usuarios",
								"login"
							]
						},
						"description": "Autentica o usuário Administrador e salva automaticamente o token JWT na variável {{jwtToken}} da coleção."
					},
					"response": []
				},
				{
					"name": "1.2. Login Usuário Comum (Sem Permissão de Exclusão)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"jwtTokenComum\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"usuario@exoapi.com\",\n  \"senha\": \"user123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/usuarios/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"usuarios",
								"login"
							]
						},
						"description": "Autentica um usuário de perfil Comum e salva o token em {{jwtTokenComum}}."
					},
					"response": []
				},
				{
					"name": "1.3. Deletar Projeto SEM Token (Bloqueado -> 401 Unauthorized)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/projetos/3",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"projetos",
								"3"
							]
						},
						"description": "Valida que usuários não autenticados recebem 401 Unauthorized ao tentar excluir um projeto."
					},
					"response": []
				},
				{
					"name": "1.4. Deletar Projeto com Usuário Comum (Bloqueado -> 403 Forbidden)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtTokenComum}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/projetos/3",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"projetos",
								"3"
							]
						},
						"description": "Valida que um usuário autenticado porém sem perfil Admin recebe 403 Forbidden ao tentar excluir um projeto."
					},
					"response": []
				},
				{
					"name": "1.5. Deletar Projeto COM Token Admin (Autorizado -> 200 OK)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/projetos/3",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"projetos",
								"3"
							]
						},
						"description": "Remove o projeto utilizando o token JWT do usuário autenticado e autorizado (Admin)."
					},
					"response": []
				}
			]
		},
